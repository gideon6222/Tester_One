; Engine configuration file.
; Regenerated by Godot when the editor saves; edit it by hand only for things
; the editor cannot set, and read the diff when it rewrites.

config_version=5

[application]

config/name="Godot Template"
config/description="Proving stack for phone games built with Godot: headless tests, a whole-run golden, a size guard, CI, and an APK that installs."
run/main_scene="res://src/game/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[display]

; Portrait, because that is the only shape these games are played in.
window/size/viewport_width=1080
window/size/viewport_height=1920
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

; "mobile" is the Vulkan mobile backend - the right default for a modern
; Android phone. "gl_compatibility" is the fallback for old hardware and costs
; real visual features; do not switch to it without measuring first.
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"

; Required for an Android export - the exporter refuses without it. Mobile
; GPUs want ETC2/ASTC rather than the desktop S3TC/BPTC formats, and importing
; both is what lets one project ship to a phone and a desktop preview.
textures/vram_compression/import_etc2_astc=true

[physics]

; Nothing here uses the physics server - collision is arithmetic in Sim, which
; is what lets the tests run with no scene tree. Left at defaults deliberately
; rather than tuned, so it is obvious it is unused.
common/physics_ticks_per_second=60
