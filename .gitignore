# Godot's import cache and per-machine editor state. Regenerated on open.
.godot/
.import/

# Export output.
build/
# ...except the marker that stops Godot importing and EXPORTING what films
# and exports leave in there. Without it the exporter packed 3,720 filmed PNG
# frames into the APK and it came out at 1.42 GB against a 28 MB budget.
!build/
!build/.gdignore
*.apk
*.aab
*.idsig

# Never commit signing material. The debug keystore is universally known and
# still does not belong here; the release keystore would be a real key leak.
# Keys live in C:\dev\keys, outside every repository.
*.keystore
*.jks
*.p12

# Godot's Android Gradle build, generated by --install-android-build-template.
# It is the export template unpacked, not source: regenerated on demand, and
# several hundred files of engine code that would drown every diff.
android/

